PORT=3001
NODE_ENV=development

# Config-driven Tax & Levy Rates
GST_RATE=0.1
SWT_RATE=0.02
DATABASE_FILE=./garden_city_sme.db

# Dynamic restricted CORS origin configuration
# Must include absolute schemes (http:// or https://) and NO trailing slash.
# For production fallback, list the tenant domains exactly as shown below:
ALLOWED_ORIGINS=https://gc.dspng.tech,https://unity.dspng.tech

# Express trust proxy configuration
# Set app.set('trust proxy', 1) is enabled on proxied/hosted deployments for rate limiting compatibility.

# Social Auth (Optional: provide real IDs to enable real flows)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
JWT_SECRET=super-secret-jwt-key-change-in-production

# Mobile-Money Payments Integration Configurations
PAYMENT_PROVIDER=mock
PAYMENT_API_BASE_URL=https://api.paymentgateway.com
PAYMENT_API_KEY=your-payment-merchant-key
PAYMENT_API_SECRET=your-payment-merchant-secret
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret-signing-key

# Live WhatsApp Promotions Integration Configurations
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=your-whatsapp-meta-cloud-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id

# Twilio WhatsApp Integration Configurations (Fallback if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
